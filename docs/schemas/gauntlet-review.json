{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Editorial Gauntlet Review",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "decision",
    "coverage",
    "criteria",
    "hard_failures",
    "feedback",
    "artifact"
  ],
  "properties": {
    "decision": {
      "type": "string",
      "enum": ["approved", "feedback"]
    },
    "coverage": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "criteria": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "number",
        "minimum": 0,
        "maximum": 10
      }
    },
    "hard_failures": {
      "type": "array",
      "items": {"type": "string"}
    },
    "feedback": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["criterion", "message"],
        "properties": {
          "criterion": {"type": "string", "minLength": 1},
          "message": {"type": "string", "minLength": 1}
        }
      }
    },
    "artifact": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!~)(?![A-Za-z]:)(?!.*\\\\)(?!.*(^|/)\\.\\.?(/|$)).+"
    }
  }
}
